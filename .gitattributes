# Auto detect text files and perform LF normalization
* text=auto
# The golden packs are checked byte for byte (their hashes and signatures cover their bytes), so
# a Windows checkout must not give their text files CRLF line endings.
/crates/jetcarp-pack/tests/golden/** -text
# The starter pack is a signed store too: its bytes must reach every checkout unchanged.
/packaging/starter-pack/** -text
# The app icon's files are made byte for byte by packaging/gen-icons.py, which checks them.
/packaging/icons/** -text
/crates/jetcarp-display/icons/** -text
/crates/jetcarp/jetcarp.ico -text
# The bundled fonts and their licences are checked byte for byte against their READMEs' SHA-256s
# (the licence texts too), so a Windows checkout must not give the text files CRLF line endings.
/crates/jetcarp-core/fonts/** -text
/crates/jetcarp-display/fonts/** -text
/docs/theme/fonts/** -text
