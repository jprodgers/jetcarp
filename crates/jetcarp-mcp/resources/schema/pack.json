{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://jprodgers.github.io/jetcarp/reference/pack.schema.json",
  "title": "JETCARP pack manifest",
  "description": "The manifest of one version of a JETCARP pack (format jetcarp-pack 1.x): stored as an object of a store (named by its SHA-256) or as an export's pack.json. The book's Pack format reference is the normative text; this schema checks a manifest's shape only (canonical JSON, hashes, signatures and every other rule are the reader's to check). Readers ignore members they do not know, so this schema allows them.",
  "type": "object",
  "required": ["format", "version", "feed", "publisher"],
  "properties": {
    "format": {"const": "jetcarp-pack"},
    "version": {"type": "string", "pattern": "^1\\.[0-9]+$", "description": "major.minor; this schema is for major version 1."},
    "requires": {"type": "array", "items": {"type": "string"}, "description": "Features a reader must understand to use the pack (none in 1.0)."},
    "feed": {"$ref": "#/definitions/feed"},
    "title": {"type": "string"},
    "description": {"type": "string"},
    "version_label": {"type": "string", "description": "Free text for people, never an order."},
    "created": {"$ref": "#/definitions/time"},
    "licence": {"type": "string", "description": "An SPDX identifier (CC0-1.0, CC-BY-4.0)."},
    "creators": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": {"type": "string"},
          "orcid": {"type": "string"},
          "role": {"type": "string", "description": "creator, contributor, curator, ..."}
        }
      }
    },
    "doi": {"type": "string"},
    "related": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["relation", "id"],
        "properties": {"relation": {"type": "string"}, "id": {"type": "string"}}
      }
    },
    "parents": {"type": "array", "items": {"$ref": "#/definitions/hash"}, "description": "The versions this one follows: the feed's previous version first, then any merged."},
    "publisher": {"$ref": "#/definitions/fingerprint"},
    "engine": {
      "type": "object",
      "properties": {
        "name": {"type": "string"},
        "version": {"type": "string"},
        "schemes": {"type": "object", "additionalProperties": {"type": "string"}},
        "rule_semantics": {"type": "object", "additionalProperties": {"type": "string"}}
      }
    },
    "tables": {"type": "object", "additionalProperties": {"$ref": "#/definitions/hash"}, "description": "For each table, the hash of its index."},
    "searches": {"type": "object", "additionalProperties": {"$ref": "#/definitions/hash"}, "description": "Search uuid to search index hash."},
    "retracts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["target"],
        "properties": {
          "target": {"type": "string", "description": "pattern:<id>, ant:<id>, quickstart:<id>, or search_run:<uuid>:<run id>."},
          "publisher": {"type": "string"},
          "reason": {"type": "string"},
          "date": {"type": "string"}
        }
      }
    },
    "retain": {"type": "array", "items": {"$ref": "#/definitions/hash"}},
    "stats": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}, "description": "Counts for people; not authoritative."},
    "slice_of": {"$ref": "#/definitions/hash"},
    "filter": {"type": "string"}
  },
  "definitions": {
    "hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "fingerprint": {"type": "string", "pattern": "^SHA256:[A-Za-z0-9+/]{43}$", "description": "A key's fingerprint as ssh-keygen -l prints it."},
    "feed": {"type": "string", "pattern": "^[A-Za-z0-9-]{1,64}$"},
    "time": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$", "description": "RFC 3339 in UTC with Z and whole seconds."}
  }
}
